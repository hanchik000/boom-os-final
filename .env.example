# BOOM OS — central server configuration template
# Copy to .env on the central server and replace CHANGE_ME values.

# PostgreSQL (Docker Compose)
POSTGRES_DB=boom_os
POSTGRES_USER=boom_admin
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# BOOM OS application
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
REDIS_URL=redis://redis:6379
DATABASE_URL=postgresql://boom_admin:CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD@postgres:5432/boom_os?schema=public
HOST=0.0.0.0
PORT=3000
BOOM_OS_PORT=3000
NODE_ENV=production
DEFAULT_TIMEZONE=Asia/Ashgabat
DEFAULT_CURRENCY=TMT
APP_URL=http://SERVER_LAN_IP:3000

# Optional
GEMINI_API_KEY=

# Optional first-run owner provisioning. Leave unset for a completely empty system.
# If supplied, these values create exactly one OWNER account on an empty database.
BOOTSTRAP_OWNER_NAME=
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PHONE=
BOOTSTRAP_OWNER_PASSWORD=

# Session security
SESSION_TTL_DAYS=7
SESSION_IDLE_TIMEOUT_MINUTES=180

# Waiter POS session security
WAITER_SESSION_TTL_HOURS=12
WAITER_IDLE_TIMEOUT_MINUTES=60

# Developer-only UI acceptance suite. Keep false/unset in normal production to prevent test data creation from the UI.
VITE_ENABLE_ACCEPTANCE_TESTS=false
