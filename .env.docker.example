# BOOM OS Docker environment template for the central computer
POSTGRES_DB=boom_os
POSTGRES_USER=boom_admin
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
BOOTSTRAP_OWNER_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
BOOM_OS_PORT=3000
DEFAULT_TIMEZONE=Asia/Ashgabat
DEFAULT_CURRENCY=TMT
APP_URL=http://SERVER_LAN_IP:3000
GEMINI_API_KEY=

# Session security
SESSION_TTL_DAYS=7
SESSION_IDLE_TIMEOUT_MINUTES=180

# Waiter POS session security
WAITER_SESSION_TTL_HOURS=12
WAITER_IDLE_TIMEOUT_MINUTES=60
