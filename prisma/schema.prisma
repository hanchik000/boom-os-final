  paper_width Int     @default(80)
  language    String  @default("ru")
  config_json String
  active      Boolean @default(true)
  created_at  String
  updated_at  String
  branch      Branch  @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  @@index([branch_id, active], map: "idx_print_profiles_branch_active")
  @@map("print_profiles")
}

