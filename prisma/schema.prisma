// Stage 34.2: a service charge configuration is now a VERSION, not a single mutable row. Editing
// the configuration archives the current version (stamping effective_to) and inserts a new one, so
// an order paid yesterday can always be explained by the version that was in force when it was
// created. branch_id is nullable because a version with scope=ORGANIZATION is the organisation-wide
// default that every branch without its own version inherits.
model ServiceChargeConfig {
  id               String  @id
  branch_id        String?
  scope            String  @default("BRANCH") // BRANCH | ORGANIZATION
  percent          Decimal @db.Decimal(5,2)   // DINE_IN service charge percentage
  takeaway_percent Decimal @db.Decimal(5,2) @default(0)
  delivery_percent Decimal @db.Decimal(5,2) @default(0)
  status           String  @default("ACTIVE")  // ACTIVE | ARCHIVED
  effective_from   String
  effective_to     String?
  note             String?
  created_by       String?
  created_at       String
  updated_at       String
  branch           Branch? @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  categories       ServiceChargeCategory[]
  allocations      ServiceChargeAllocation[]
  ledger           ServiceChargeLedger[]
  orders           Order[]

  @@index([branch_id, status, effective_from], map: "idx_service_charge_config_branch_status_from")
  @@index([scope, status, effective_from], map: "idx_service_charge_config_scope_status_from")
  @@map("service_charge_configs")
}

// One row per distribution category of a configuration version. `percent` is the share of the SAME
// base the service charge itself is computed from, so the categories' percentages are directly
// comparable with the configuration's own percentage and can never exceed it. `mode` decides how
// that category's money reaches people: INDIVIDUAL pays named employees their own stated
// percentage immediately, COMMON forms one pool that is distributed later by `strategy`.
model ServiceChargeCategory {
  id          String  @id
  config_id   String
  category    String  // BAR | KITCHEN | WAITERS | MANAGERS | OTHER
  percent     Decimal @db.Decimal(5,2)
  mode        String  @default("COMMON")  // COMMON | INDIVIDUAL
  strategy    String  @default("EQUAL")   // EQUAL | BY_SALES | BY_ORDERS | BY_HOURS
  active      Boolean @default(true)
  created_at  String
  updated_at  String

  config      ServiceChargeConfig @relation(fields: [config_id], references: [id], onDelete: Cascade)
  allocations ServiceChargeAllocation[]

  @@unique([config_id, category], map: "uq_service_charge_category_config_category")
  @@index([config_id, active], map: "idx_service_charge_category_config_active")
  @@map("service_charge_categories")
}

model ServiceChargeAllocation {
  id             String  @id
  config_id      String
  category_id    String?
  target_type    String  // GROUP | INDIVIDUAL | MEMBER (a participant of a COMMON category pool)
  department     String?
  user_id        String?
  percent        Decimal @db.Decimal(5,2)
  active         Boolean @default(true)
  created_at     String
  updated_at     String
  config         ServiceChargeConfig @relation(fields: [config_id], references: [id], onDelete: Cascade)
  category       ServiceChargeCategory? @relation(fields: [category_id], references: [id], onDelete: Cascade)
  user           User? @relation(fields: [user_id], references: [id], onDelete: Restrict)
  @@index([config_id, active], map: "idx_service_charge_alloc_config_active")
  @@index([user_id, active], map: "idx_service_charge_alloc_user_active")
  @@map("service_charge_allocations")
}

model ServiceChargeLedger {
  id             String  @id
  branch_id      String
  order_id       String
  user_id        String?
  target_type    String
  department     String?
  base_amount    Decimal @db.Decimal(12,2)
  percent        Decimal @db.Decimal(5,2)
  amount         Decimal @db.Decimal(12,2)
  status         String  @default("EARNED")  // EARNED | POOLED | DISTRIBUTED | REVERSED
  category       String?
  config_id      String?
  strategy       String?
  // Never null, so the uniqueness that makes recording idempotent actually holds -- a NULL user_id
  // or department would otherwise make every retry look like a new row to Postgres.
  allocation_key String  @default("")
  pool_id        String?
  created_at     String
  branch         Branch @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  order          Order  @relation(fields: [order_id], references: [id], onDelete: Restrict)
  user           User?  @relation(fields: [user_id], references: [id], onDelete: SetNull)
  config         ServiceChargeConfig? @relation(fields: [config_id], references: [id], onDelete: SetNull)
  pool           ServiceChargeLedger?  @relation("ServiceChargePoolDistribution", fields: [pool_id], references: [id], onDelete: Cascade)
  distributions  ServiceChargeLedger[] @relation("ServiceChargePoolDistribution")
  @@unique([order_id, allocation_key], map: "uq_service_charge_ledger_order_allocation_key")
  @@index([branch_id, created_at], map: "idx_service_charge_ledger_branch_created")
  @@index([user_id, created_at], map: "idx_service_charge_ledger_user_created")
  @@map("service_charge_ledger")
}

