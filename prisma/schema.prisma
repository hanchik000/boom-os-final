// ================================================================================================
// Stage 35.3 -- the Visual Catalog. Manager-configured presentation blocks (hero/category/banner/
// promotion/item) that reference REAL menu categories/items -- never a second price or a second
// product. link_type decides what the block points at (CATEGORY/ITEM/EXTERNAL/PROMOTION); category
// and menu_item are nullable FKs to the existing Menu Engine, so a block can never outlive or
// diverge from the real product it names.
// ================================================================================================
model VisualCatalogBlock {
  id            String   @id
  branch_id     String?
  type          String   @default("BANNER")
  title_ru      String?
  title_tk      String?
  // Stage 39: EN joins the existing RU/TK pair, same paired-column i18n pattern as everywhere else.
  title_en      String?
  subtitle_ru   String?
  subtitle_tk   String?
  subtitle_en   String?
  // Stage 39: a call-to-action label for HERO / CTA sections. The DESTINATION is still the
  // existing link_type/category_id/menu_item_id/external_url fields -- this is only its wording.
  cta_label_ru  String?
  cta_label_tk  String?
  cta_label_en  String?
  // -------------------------------------------------------------------------------------------
  // Stage 39 -- per-section APPEARANCE presets.
  //
  // These are enums validated server-side against a fixed list, never free CSS. Administrators
  // choose from BOOM OS design tokens; they cannot inject a style string, a class name or markup.
  // Nothing here is business data: a section can say how a dish is shown, never what it costs.
  // -------------------------------------------------------------------------------------------
  card_style    String?  // STANDARD | PREMIUM | COMPACT | IMAGE_FIRST
  density       String?  // COMPACT | NORMAL | SPACIOUS
  image_ratio   String?  // SQUARE | PORTRAIT | LANDSCAPE | WIDE | AUTO
  overlay       String?  // NONE | SOFT | STRONG
  alignment     String?  // LEFT | CENTER
  media_url     String?
  media_kind    String?
  media_asset_id String?
  link_type     String   @default("NONE")
  link_target   String?
  category_id   String?
  menu_item_id  String?
  external_url  String?
  sort_order    Int      @default(0)
  priority      Int      @default(0)
  active        Boolean  @default(true)
  schedule_start String?
  schedule_end   String?
  // Stage 35.6: which customer-menu channels this block appears on. NULL/empty means every
  // channel (the pre-35.6 default, so existing blocks keep working unchanged) -- never a second
  // catalog per channel, only presentation targeting on the SAME blocks.
  channels      String?
  created_by    String?
  updated_by    String?
  created_at    String
  updated_at    String

  branch       Branch?      @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  category     MenuCategory? @relation(fields: [category_id], references: [id], onDelete: SetNull)
  menu_item    MenuItem?    @relation(fields: [menu_item_id], references: [id], onDelete: SetNull)
  creator      User?        @relation("VisualCatalogCreatedBy", fields: [created_by], references: [id], onDelete: SetNull)
  updater      User?        @relation("VisualCatalogUpdatedBy", fields: [updated_by], references: [id], onDelete: SetNull)

  @@index([branch_id, active, sort_order, priority], map: "idx_visual_catalog_blocks_branch_order")
  @@index([schedule_start, schedule_end], map: "idx_visual_catalog_blocks_schedule")
  @@map("visual_catalog_blocks")
}

// ================================================================================================
// Stage 35.6 -- the Promotion Engine. A promotion attaches a REAL, server-computed promotional
// price to a REAL menu item -- never a second product, never a client-invented price. Whether a
// promotion is live right now is never a stored flag: it is `active AND starts_at <= now <=
// ends_at`, computed on every read, so expiry is automatic and cannot go stale.
// ================================================================================================
model Promotion {
  id            String   @id
  branch_id     String?
  menu_item_id  String
  promo_price   Decimal  @db.Decimal(12,2)
  starts_at     String
  ends_at       String
  active        Boolean  @default(true)
  // Where the manager allowed this promotion to surface -- the product card, the main catalog,
  // a banner, its category, and/or a dedicated Promotions section. Comma-separated, like
  // VisualCatalogBlock.channels; empty means "everywhere" is left to the manager's own choice
  // via at least one placement, enforced in the route, not invented here.
  placements    String   @default("PRODUCT_CARD,CATALOG")
  badge_ru      String?  @default("Акция")
  badge_tk      String?  @default("BOOM DEAL")
  created_by    String?
  updated_by    String?
  created_at    String
  updated_at    String

  branch    Branch?  @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  menu_item MenuItem @relation(fields: [menu_item_id], references: [id], onDelete: Cascade)
  creator   User?    @relation("PromotionCreatedBy", fields: [created_by], references: [id], onDelete: SetNull)
  updater   User?    @relation("PromotionUpdatedBy", fields: [updated_by], references: [id], onDelete: SetNull)

  @@index([branch_id, active, starts_at, ends_at], map: "idx_promotions_branch_active_window")
  @@index([menu_item_id, active], map: "idx_promotions_menu_item")
  @@map("promotions")
}

// Stage 35.2 -- media configured for POS terminals (idle screens, promotional loops). Presentation
// only: it never carries a price or a product and never feeds the Order Core.
model PosMedia {
  id             String   @id
  branch_id      String?
  name           String
  kind           String
  url            String
  mime_type      String?
  size_bytes     BigInt?
  active         Boolean  @default(true)
  priority       Int      @default(0)
  sort_order     Int      @default(0)
  schedule_start String?
  schedule_end   String?
  is_fallback    Boolean  @default(false)
  created_by     String?
  updated_by     String?
  created_at     String
  updated_at     String

  @@index([branch_id, active], map: "idx_pos_media_branch_active")
  @@index([priority, sort_order], map: "idx_pos_media_priority_order")
  @@map("pos_media")
}

// Stage 35.4 -- reusable menu media assets (image/video/GIF/poster) that Visual Catalog blocks and
// menu items reference by URL. One media store, not a second one per surface.
model MediaAsset {
  id          String   @id
  branch_id   String?
  name        String
  kind        String
  mime_type   String
  url         String
  poster_url  String?
  alt_ru      String?
  alt_tk      String?
  focal_x     Float    @default(50)
  focal_y     Float    @default(50)
  size_bytes  BigInt?
  width       Int?
  height      Int?
  duration_ms Int?
  active      Boolean  @default(true)
  priority    Int      @default(0)
  created_by  String?
  updated_by  String?
  created_at  String
  updated_at  String

  menu_items  MenuItem[]
  gallery_of  MenuItemMedia[]

  @@index([branch_id, active, priority], map: "idx_media_assets_branch_active")
  @@index([kind, active], map: "idx_media_assets_kind")
  @@map("media_assets")
}


// -----------------------------------------------------------------------------------------------
// Stage 37 -- customer-facing allergen declarations.
//
// A regulated, fixed reference list (the EU 14), seeded once and linked to dishes. It is public
// information by definition, so it carries only a code and localized labels -- no cost, no
// supplier, no quantity, nothing that belongs to the internal recipe.
// -----------------------------------------------------------------------------------------------
model Allergen {
  id          String   @id
  code        String   @unique
  label_ru    String
  label_tk    String
  label_en    String
  sort_order  Int      @default(0)
  active      Boolean  @default(true)
  created_at  String
  updated_at  String

  menu_items  MenuItemAllergen[]

  @@index([active, sort_order], map: "idx_allergens_active")
  @@map("allergens")
}

model MenuItemAllergen {
  id           String @id
  menu_item_id String
  allergen_id  String
  created_at   String

  menu_item    MenuItem @relation(fields: [menu_item_id], references: [id], onDelete: Cascade, map: "menu_item_allergens_item_fkey")
  allergen     Allergen @relation(fields: [allergen_id], references: [id], onDelete: Cascade, map: "menu_item_allergens_allergen_fkey")

  @@unique([menu_item_id, allergen_id], map: "menu_item_allergens_pair_key")
  @@index([menu_item_id], map: "idx_menu_item_allergens_item")
  @@map("menu_item_allergens")
}

// -----------------------------------------------------------------------------------------------
// Stage 37 -- the dish gallery.
//
// `menu_items.media_asset_id` stays exactly as Stage 36 left it: the ONE primary photo every
// surface already reads. This table adds the additional assets (extra photos, a video, a 360
// asset) without touching that column or duplicating the Media Engine -- each row is a reference
// to an existing media_assets row, never a second copy of the file.
// -----------------------------------------------------------------------------------------------
model MenuItemMedia {
  id             String @id
  menu_item_id   String
  media_asset_id String
  sort_order     Int    @default(0)
  created_at     String

  menu_item      MenuItem   @relation(fields: [menu_item_id], references: [id], onDelete: Cascade, map: "menu_item_media_item_fkey")
  media_asset    MediaAsset @relation(fields: [media_asset_id], references: [id], onDelete: Cascade, map: "menu_item_media_asset_fkey")

  @@unique([menu_item_id, media_asset_id], map: "menu_item_media_pair_key")
  @@index([menu_item_id, sort_order], map: "idx_menu_item_media_item")
  @@map("menu_item_media")
}


// -----------------------------------------------------------------------------------------------
// Stage 39 -- the page-level design of a branch's Customer Menu.
//
// One row per branch (branch_id is unique), holding ONLY preset identifiers drawn from the
// existing BOOM OS design tokens. There is deliberately no raw CSS, no HTML and no script field:
// every value is validated server-side against a fixed enum, so an administrator can restyle the
// guest menu without any route through which markup or a stylesheet could be injected.
//
// This is presentation only. It carries no price, no availability and no dish data -- those stay
// in the Menu Engine, which the guest menu reads directly.
// -----------------------------------------------------------------------------------------------
model SiteDesign {
  id            String  @id
  branch_id     String  @unique
  theme         String  @default("MIDNIGHT")   // MIDNIGHT | GRAPHITE | CHARCOAL
  accent        String  @default("GOLD")       // GOLD | AMBER | COPPER | IVORY
  typography    String  @default("EDITORIAL")  // EDITORIAL | COMPACT | DISPLAY
  card_style    String  @default("STANDARD")   // STANDARD | PREMIUM | COMPACT | IMAGE_FIRST
  density       String  @default("NORMAL")     // COMPACT | NORMAL | SPACIOUS
  radius        String  @default("ROUNDED")    // SHARP | SOFT | ROUNDED
  image_ratio   String  @default("LANDSCAPE")  // SQUARE | PORTRAIT | LANDSCAPE | WIDE | AUTO
  show_hero     Boolean @default(true)
  updated_by    String?
  created_at    String
  updated_at    String

  branch        Branch @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  updater       User?  @relation("SiteDesignUpdatedBy", fields: [updated_by], references: [id], onDelete: SetNull)

  @@map("site_designs")
}


// ----------------------------------------------------------------------------------------------
// Stage 42 — Smart Kitchen. The kitchen's own layer on top of Order Core, never beside it: every
// task points at the order line it came from, and the order's money, recipe and stock behaviour is
// untouched by anything in this section.
// ----------------------------------------------------------------------------------------------

/// A station of a branch's kitchen. Rows, not hardcoded constants: a branch can run GRILL/FRY/
/// COLD/BAR/EXPO, or wok and pizza stations, without a code change.
model KitchenStation {
  id                String   @id
  branch_id         String
  code              String
  name_ru           String
  name_tk           String
  is_expo           Boolean  @default(false)
  parallel_capacity Int      @default(1)
  sort_order        Int      @default(0)
  status            String   @default("ACTIVE")
  deleted_at        String?
  created_at        String
  updated_at        String

  branch            Branch   @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  item_routes       KitchenItemRoute[]
  category_routes   KitchenCategoryRoute[]
  tasks             KdsItemTask[]
  thresholds        KitchenThreshold[]
  alerts            KitchenAlert[]

  @@unique([branch_id, code], map: "kitchen_stations_branch_code_key")
  @@index([branch_id, status, sort_order], map: "idx_kitchen_stations_branch")
  @@map("kitchen_stations")
}

/// Which station cooks this dish, and the standard time a manager set for it. is_secondary is an
/// ADDITIONAL step on another station rather than a replacement.
model KitchenItemRoute {
  id                String   @id
  menu_item_id      String
  station_id        String
  standard_minutes  Decimal  @db.Decimal(8,2) @default(5)
  tolerance_minutes Decimal  @db.Decimal(8,2) @default(2)
  is_secondary      Boolean  @default(false)
  status            String   @default("ACTIVE")
  created_at        String
  updated_at        String

  menu_item         MenuItem       @relation(fields: [menu_item_id], references: [id], onDelete: Cascade)
  station           KitchenStation @relation(fields: [station_id], references: [id], onDelete: Cascade)

  @@unique([menu_item_id, station_id], map: "menu_item_routes_item_station_key")
  @@index([menu_item_id, status], map: "idx_menu_item_routes_item")
  @@map("menu_item_routes")
}

/// The explicitly configured category fallback. Nothing in this system infers a station from a
/// dish name: with no dish route and no category route, the item waits for a human to assign it.
model KitchenCategoryRoute {
  id                String   @id
  category_id       String
  station_id        String
  standard_minutes  Decimal  @db.Decimal(8,2) @default(5)
  tolerance_minutes Decimal  @db.Decimal(8,2) @default(2)
  status            String   @default("ACTIVE")
  created_at        String
  updated_at        String

  category          MenuCategory   @relation(fields: [category_id], references: [id], onDelete: Cascade)
  station           KitchenStation @relation(fields: [station_id], references: [id], onDelete: Cascade)

  @@unique([category_id, station_id], map: "menu_category_routes_category_station_key")
  @@map("menu_category_routes")
}

/// One order line on one station. The norm (standard_minutes), the prediction (forecast_*) and the
/// fact (started_at/ready_at) are three separate things and are never collapsed into one another.
model KdsItemTask {
  id                   String   @id
  branch_id            String
  order_id             String
  order_item_id        String
  station_id           String?
  menu_item_id         String?
  title_snapshot       String
  quantity             Int      @default(1)
  is_secondary         Boolean  @default(false)
  status               String   @default("QUEUED")
  priority             Int      @default(0)
  standard_minutes     Decimal? @db.Decimal(8,2)
  tolerance_minutes    Decimal? @db.Decimal(8,2)
  expected_minutes     Decimal? @db.Decimal(8,2)
  forecast_source      String?
  forecast_start_at    String?
  forecast_ready_at    String?
  forecast_confidence  String?
  forecast_sample_size Int      @default(0)
  accepted_at          String?
  started_at           String?
  ready_at             String?
  served_at            String?
  cancelled_at         String?
  delay_state          String   @default("NONE")
  delay_reason         String?
  // Stage 43: the order's items must leave the kitchen together, and the shared target the
  // stations are paced to. The flag comes from the waiter's existing SERVE_TOGETHER note.
  serve_together       Boolean  @default(false)
  coordinated_ready_at String?
  // Stage 43: how many times this task's critical delay has already been escalated, which is what
  // makes a repeating reminder idempotent.
  escalation_round     Int      @default(0)
  reassigned_from      String?
  reassign_reason      String?
  created_at           String
  updated_at           String

  branch               Branch          @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  order                Order           @relation(fields: [order_id], references: [id], onDelete: Cascade)
  order_item           OrderItem       @relation(fields: [order_item_id], references: [id], onDelete: Cascade)
  station              KitchenStation? @relation(fields: [station_id], references: [id], onDelete: SetNull)
  menu_item            MenuItem?       @relation(fields: [menu_item_id], references: [id], onDelete: SetNull)
  alerts               KitchenAlert[]

  @@unique([order_item_id, station_id], map: "kds_item_tasks_item_station_key")
  @@index([order_id, serve_together], map: "idx_kds_item_tasks_serve_together")
  @@index([branch_id, delay_state, escalation_round], map: "idx_kds_item_tasks_escalation")
  @@index([branch_id, station_id, status, created_at], map: "idx_kds_item_tasks_station_queue")
  @@index([order_id], map: "idx_kds_item_tasks_order")
  @@index([station_id, menu_item_id, ready_at], map: "idx_kds_item_tasks_history")
  @@map("kds_item_tasks")
}

/// When lateness becomes a warning, a delay or a critical delay, as ratios of the expected time.
/// A row with no station and no category is the branch default.
model KitchenThreshold {
  id               String   @id
  branch_id        String
  station_id       String?
  category_id      String?
  warning_ratio    Decimal  @db.Decimal(5,2) @default(0.80)
  late_ratio       Decimal  @db.Decimal(5,2) @default(1.00)
  critical_ratio   Decimal  @db.Decimal(5,2) @default(1.50)
  escalate_minutes Int      @default(5)
  updated_by       String?
  created_at       String
  updated_at       String

  branch           Branch          @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  station          KitchenStation? @relation(fields: [station_id], references: [id], onDelete: Cascade)
  category         MenuCategory?   @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@unique([branch_id, station_id, category_id], map: "kitchen_thresholds_scope_key")
  @@index([branch_id, category_id], map: "idx_kitchen_thresholds_category")
  @@map("kitchen_thresholds")
}

/// A message from the floor to the kitchen. It carries no price, no quantity and no recipe: an
/// actual change to an order still goes through the existing approval routes.
model KitchenComment {
  id              String   @id
  branch_id       String
  order_id        String
  order_item_id   String?
  kind            String
  text            String?
  author_user_id  String?
  author_role     String?
  source          String
  after_start     Boolean  @default(false)
  acknowledged_at String?
  acknowledged_by String?
  created_at      String

  branch          Branch     @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  order           Order      @relation(fields: [order_id], references: [id], onDelete: Cascade)
  order_item      OrderItem? @relation(fields: [order_item_id], references: [id], onDelete: SetNull)

  @@index([order_id, created_at], map: "idx_kitchen_comments_order")
  @@index([branch_id, acknowledged_at, created_at], map: "idx_kitchen_comments_branch_new")
  @@map("kitchen_comments")
}

/// Delay notifications, help requests and escalations. dedupe_key is the idempotency: the same
/// delay on the same task exists at most once, no matter how often a screen refreshes.
model KitchenAlert {
  id              String   @id
  branch_id       String
  station_id      String?
  order_id        String?
  task_id         String?
  type            String
  severity        String   @default("INFO")
  audience        String
  reason          String?
  message_ru      String?
  message_tk      String?
  dedupe_key      String   @unique(map: "kitchen_alerts_dedupe_key")
  created_by      String?
  acknowledged_at String?
  acknowledged_by String?
  resolution      String?
  created_at      String

  branch          Branch          @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  station         KitchenStation? @relation(fields: [station_id], references: [id], onDelete: SetNull)
  order           Order?          @relation(fields: [order_id], references: [id], onDelete: Cascade)
  task            KdsItemTask?    @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@index([branch_id, acknowledged_at, created_at], map: "idx_kitchen_alerts_branch_open")
  @@map("kitchen_alerts")
}

/// Who assembled an order and who took it away -- and, when an incomplete order was released,
/// which items were missing, why, and on whose authority.
model ExpoHandover {
  id            String  @id
  branch_id     String
  order_id      String
  kind          String
  missing_items String?
  reason        String?
  actor_user_id String?
  actor_role    String?
  created_at    String

  branch        Branch  @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  order         Order   @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id, created_at], map: "idx_expo_handovers_order")
  @@index([branch_id, created_at], map: "idx_expo_handovers_branch")
  @@map("expo_handovers")
}
