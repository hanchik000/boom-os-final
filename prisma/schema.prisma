model StockMovement {
  id               String  @id
  branch_id        String
  inventory_item_id String
  type             String
  quantity         Decimal @db.Decimal(14,4)
  // Stage 34.1: widened from DECIMAL(14,2) to DECIMAL(14,4). Stage 34 started stamping the
  // ingredient's weighted-average cost (itself DECIMAL(14,4)) onto SALE movements, and two
  // decimals silently rounded it (0.0250/kg was stored as 0.03), corrupting every cost read back
  // from the ledger. It now carries the same precision as inventory_items.average_cost.
  unit_cost        Decimal? @db.Decimal(14,4)
  reference_type   String?
  reference_id     String?
  reason           String?
  created_by       String?
  created_at       String

  branch           Branch @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  inventory_item   InventoryItem @relation(fields: [inventory_item_id], references: [id], onDelete: Restrict)

  @@index([branch_id, created_at], map: "idx_stock_movements_branch_created")
  @@index([inventory_item_id, created_at], map: "idx_stock_movements_item_created")
  @@index([branch_id, type], map: "idx_stock_movements_branch_type")
  @@unique([branch_id, reference_type, reference_id, inventory_item_id, type], map: "uq_stock_movement_reference")
  @@map("stock_movements")
}

model WaiterProfile {
  user_id      String   @id
