datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String                  @id
  full_name           String
  phone               String                  @unique
  email               String                  @unique
  password_hash       String
  avatar_url          String?
  status              String                  @default("ACTIVE")
  employment_status   String                  @default("ACTIVE")
  disciplinary_status String                  @default("NONE")
  joined_at           String?
  status_reason       String?
  status_changed_at   String?
  status_changed_by   String?
  branch_id           String?
  created_at          String
  updated_at          String
  last_login_at       String?
  deleted_at          String?

  branch              Branch?                 @relation("PrimaryBranchUsers", fields: [branch_id], references: [id], onDelete: SetNull)
  user_roles          UserRole[]
  branch_access       UserBranchAccess[]
  status_history      EmployeeStatusHistory[]
  audit_logs          AuditLog[]
  settings_updated    SystemSetting[]
  auth_sessions       AuthSession[]
  waiter_pos_sessions  WaiterPosSession[]
  employee_profile    EmployeeProfile?
  waiter_access_code  WaiterAccessCode?
  waiter_profile      WaiterProfile?
  waiter_status_history WaiterStatusHistory[]
  service_charge_allocations ServiceChargeAllocation[]
  service_charge_ledger ServiceChargeLedger[]
  kpi_rules           KpiRule[]
  kpi_ledger          KpiLedger[]
  operator_pos_sessions OperatorPosSession[]
  print_jobs          PrintJob[]
  cash_shifts          CashShift[]
  payments             Payment[]
  orders_as_waiter     Order[]                 @relation("WaiterOrders")
  credit_accounts_as_employee   CreditAccount[]     @relation("EmployeeCreditAccounts")
  credit_transactions_as_cashier CreditTransaction[] @relation("CreditTransactionsAsCashier")
  credit_transactions_as_approver CreditTransaction[] @relation("CreditTransactionsAsApprover")
  inventory_counts    InventoryCount[]
  order_discounts_applied  OrderDiscount[] @relation("OrderDiscountAppliedBy")
  compliments_requested    ComplimentRequest[] @relation("ComplimentRequester")
  compliments_approved     ComplimentRequest[] @relation("ComplimentApprover")
  order_closures_requested OrderClosure[] @relation("OrderClosureRequester")
  order_closures_approved  OrderClosure[] @relation("OrderClosureApprover")
  visual_catalog_created    VisualCatalogBlock[] @relation("VisualCatalogCreatedBy")
  visual_catalog_updated    VisualCatalogBlock[] @relation("VisualCatalogUpdatedBy")
  promotions_created        Promotion[] @relation("PromotionCreatedBy")
  promotions_updated        Promotion[] @relation("PromotionUpdatedBy")

  @@index([email], map: "idx_users_email")
  @@index([phone], map: "idx_users_phone")
  @@index([branch_id], map: "idx_users_branch_id")
  @@index([status], map: "idx_users_status")
  @@index([employment_status], map: "idx_users_employment_status")
  @@index([disciplinary_status], map: "idx_users_disciplinary_status")
  @@map("users")
  site_designs_updated SiteDesign[] @relation("SiteDesignUpdatedBy")
}


model AuthSession {
  id          String   @id
  user_id     String
  token_hash  String   @unique
  expires_at  String
  created_at  String
  last_seen_at String?
  revoked_at  String?
  ip_address  String?
  user_agent  String?

  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "idx_auth_sessions_user")
  @@index([expires_at], map: "idx_auth_sessions_expires")
  @@index([revoked_at], map: "idx_auth_sessions_revoked")
  @@map("auth_sessions")
}

model Role {
  id               String           @id
  code             String           @unique
  name             String
  description      String?
  is_system        Int              @default(0)
  status           String           @default("ACTIVE")
  created_at       String
  updated_at       String

  user_roles       UserRole[]
  role_permissions RolePermission[]

  @@index([code], map: "idx_roles_code")
  @@index([status], map: "idx_roles_status")
  @@map("roles")
}

model Permission {
  id               String           @id
  code             String           @unique
  name             String
  module           String
  description      String?
  created_at       String

  role_permissions RolePermission[]

  @@index([code], map: "idx_permissions_code")
  @@index([module], map: "idx_permissions_module")
  @@map("permissions")
}

model RolePermission {
  id            String     @id
  role_id       String
  permission_id String
  created_at    String

  role          Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([role_id, permission_id])
  @@index([role_id], map: "idx_role_permissions_role")
  @@index([permission_id], map: "idx_role_permissions_perm")
  @@map("role_permissions")
}

model UserRole {
  id         String   @id
  user_id    String
  role_id    String
  created_at String

  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([user_id, role_id])
  @@index([user_id], map: "idx_user_roles_user")
  @@index([role_id], map: "idx_user_roles_role")
  @@map("user_roles")
}

model Branch {
  id           String             @id
  name         String
  code         String             @unique
  address      String
  phone        String
  timezone     String             @default("Asia/Ashgabat")
  currency     String             @default("TMT")
  status       String             @default("ACTIVE")
  franchise_id String?
  // Stage 35.6: the opaque credential a QR code encodes. The server resolves THIS to a branch --
  // a QR menu never trusts a client-supplied branch_id. Nullable so existing branches are
  // unaffected until a manager (re)generates one.
  qr_token     String?            @unique
  created_at   String
  updated_at   String

  franchise    Franchise?         @relation(fields: [franchise_id], references: [id], onDelete: SetNull)
  users        User[]             @relation("PrimaryBranchUsers")
  user_access  UserBranchAccess[]
  audit_logs   AuditLog[]
  waiter_codes         WaiterAccessCode[]
  waiter_pos_sessions  WaiterPosSession[]
  menu_categories       MenuCategory[]
  menu_items            MenuItem[]
  dining_areas          DiningArea[]
  dining_tables         DiningTable[]
  orders                Order[]
  order_sequence        BranchOrderSequence?
  cash_shifts            CashShift[]
  payments               Payment[]
  kds_tickets            KdsTicket[]
  inventory_items        InventoryItem[]
  order_item_removal_approvals OrderItemRemovalApproval[]
  recipes                Recipe[]
  suppliers              Supplier[]
  purchases              Purchase[]
  stock_movements        StockMovement[]
  service_charge_configs ServiceChargeConfig[]
  service_charge_ledger ServiceChargeLedger[]
  kpi_rules              KpiRule[]
  kpi_ledger             KpiLedger[]
  operator_pos_sessions  OperatorPosSession[]
  print_profiles         PrintProfile[]
  print_jobs             PrintJob[]
  menu_modifier_groups   MenuModifierGroup[]
  customers              Customer[]
  credit_accounts        CreditAccount[]
  credit_transactions    CreditTransaction[]
  inventory_counts       InventoryCount[]
  order_closures         OrderClosure[]
  order_discounts        OrderDiscount[]
  order_bills            OrderBill[]
  boomcoin_ledger        BoomcoinLedger[]
  boomcards              Boomcard[]
  boomcard_events        BoomcardEvent[]
  boomcard_gifts         BoomcardBirthdayGift[]
  boomback_ledger        BoombackLedger[]
  compliment_requests    ComplimentRequest[]
  visual_catalog_blocks  VisualCatalogBlock[]
  promotions             Promotion[]

  kitchen_stations       KitchenStation[]
  kds_item_tasks         KdsItemTask[]
  kitchen_thresholds     KitchenThreshold[]
  kitchen_comments       KitchenComment[]
  kitchen_alerts         KitchenAlert[]
  expo_handovers         ExpoHandover[]

  @@index([code], map: "idx_branches_code")
  @@index([status], map: "idx_branches_status")
  @@index([franchise_id], map: "idx_branches_franchise")
  @@map("branches")
  site_design   SiteDesign?
}

model UserBranchAccess {
  id         String   @id
  user_id    String
  branch_id  String
  created_at String

  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  branch     Branch   @relation(fields: [branch_id], references: [id], onDelete: Cascade)

  @@unique([user_id, branch_id])
  @@index([user_id], map: "idx_user_branch_user")
  @@index([branch_id], map: "idx_user_branch_branch")
  @@index([user_id, branch_id], map: "idx_user_branch_user_branch")
  @@map("user_branch_access")
}

model Franchise {
  id           String    @id
  name         String
  code         String    @unique
  legal_name   String
  contact_name String
  phone        String
  email        String
  address      String
  status       String    @default("ACTIVE")
  created_at   String
  updated_at   String
  deleted_at   String?

  branches     Branch[]

  @@index([code], map: "idx_franchises_code")
  @@index([status], map: "idx_franchises_status")
  @@index([deleted_at], map: "idx_franchises_deleted_at")
  @@map("franchises")
}

model EmployeeProfile {
  user_id          String   @id
  employee_code    String   @unique
  position_title   String
  department       String?
  employment_type  String   @default("FULL_TIME")
  hire_date        String?
  termination_date String?
  notes            String?
  created_at       String
  updated_at       String

  user             User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([position_title], map: "idx_employee_profiles_position")
  @@index([department], map: "idx_employee_profiles_department")
  @@index([employment_type], map: "idx_employee_profiles_type")
  @@map("employee_profiles")
}

model EmployeeStatusHistory {
  id                  String  @id
  user_id             String
  employment_status   String
  disciplinary_status String
  reason              String?
  notes               String?
  effective_from      String?
  effective_until     String?
  changed_by          String?
  created_at          String

  user                User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "idx_emp_status_user")
  @@index([created_at], map: "idx_emp_status_created")
  @@index([employment_status], map: "idx_emp_status_emp")
  @@index([disciplinary_status], map: "idx_emp_status_disc")
  @@map("employee_status_history")
}

model WaiterAccessCode {
  user_id       String   @id
  branch_id     String
  code_hash     String   @unique
  status        String   @default("ACTIVE")
  created_at    String
  updated_at    String
  changed_by    String?
  last_used_at  String?

  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  branch        Branch   @relation(fields: [branch_id], references: [id], onDelete: Restrict)

  @@index([branch_id], map: "idx_waiter_codes_branch")
  @@index([status], map: "idx_waiter_codes_status")
  @@map("waiter_access_codes")
}

model WaiterPosSession {
  id            String   @id
  user_id       String
  branch_id     String
  device_id     String
  token_hash    String   @unique
  status        String   @default("ACTIVE")
  expires_at    String
  last_seen_at  String
  created_at    String
  revoked_at    String?

  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  branch        Branch   @relation(fields: [branch_id], references: [id], onDelete: Restrict)

  @@index([user_id], map: "idx_waiter_pos_sessions_user")
  @@index([branch_id], map: "idx_waiter_pos_sessions_branch")
  @@index([status], map: "idx_waiter_pos_sessions_status")
  @@index([expires_at], map: "idx_waiter_pos_sessions_expires")
  @@map("waiter_pos_sessions")
}


model MenuCategory {
  id          String     @id
  branch_id   String?
  name_ru     String
  name_tk     String
  // Stage 37: EN follows the project's EXISTING i18n pattern (paired *_ru/*_tk columns). There is
  // no translation table in this schema to reuse, and introducing one would be a far larger change
  // than the stage calls for. Nullable, so every existing row stays valid and RU remains the
  // fallback when EN has not been written yet.
  name_en     String?
  sort_order  Int        @default(0)
  status      String     @default("ACTIVE")
  deleted_at  String?
  created_at  String
  updated_at  String

  branch      Branch?    @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  items       MenuItem[]
  visual_catalog_blocks VisualCatalogBlock[]

  @@index([branch_id], map: "idx_menu_categories_branch")
  @@index([status], map: "idx_menu_categories_status")
  @@index([deleted_at], map: "idx_menu_categories_deleted_at")
  @@map("menu_categories")
  station_routes KitchenCategoryRoute[]
  kitchen_thresholds KitchenThreshold[]
}

model MenuItem {
  id             String        @id
  branch_id      String?
  category_id    String
  // Stage 36: the dish photo/video. A nullable FK into the EXISTING Stage 35.4 Media Engine --
  // no second media table, no duplicated image record. Every surface that shows a dish (admin
  // menu, waiter POS, customer menu, visual catalog) reads this one asset.
  media_asset_id String?
  sku            String        @unique
  name_ru        String
  name_tk        String
  // Stage 37: EN dish content, same paired-column i18n pattern as RU/TK above.
  name_en        String?
  description_ru String?
  description_tk String?
  description_en String?
  // Stage 37: CUSTOMER-FACING ingredients ("beef, cheddar, lettuce"). This is deliberately NOT
  // the recipe: the recipe lives in `recipes` -> `recipe_ingredients` -> `inventory_items` with
  // quantities and cost, and none of that is ever exposed on a public route.
  ingredients_ru String?
  ingredients_tk String?
  ingredients_en String?
  // Stage 37: structured portion weight -- a number and a unit, never a formatted string, so it
  // can be validated, converted and rendered per locale.
  weight_value   Decimal?      @db.Decimal(10,3)
  weight_unit    String?
  smart_tags_ru String @default("")
  smart_tags_tk String @default("")
  price          Decimal       @db.Decimal(12,2)
  status         String        @default("ACTIVE")
  sort_order     Int           @default(0)
  deleted_at     String?
  created_at     String
  updated_at     String

  branch         Branch?       @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  category       MenuCategory  @relation(fields: [category_id], references: [id], onDelete: Restrict)
  media_asset    MediaAsset?   @relation(fields: [media_asset_id], references: [id], onDelete: SetNull)
  order_items    OrderItem[]
  recipes        Recipe[]
  modifier_groups MenuModifierGroup[]
  birthday_gifts BoomcardBirthdayGift[]
  compliments    ComplimentRequest[]
  boomcard_events BoomcardEvent[]
  visual_catalog_blocks VisualCatalogBlock[]
  promotions      Promotion[]
  allergens       MenuItemAllergen[]
  gallery         MenuItemMedia[]
  // Stage 37: modifier options that point back AT this dish (e.g. a "Cheddar" option sourced
  // from the real Cheddar menu item), which is what gives a selected modifier a recipe.
  sourced_modifiers MenuModifier[] @relation("ModifierSourceItem")

  @@index([branch_id], map: "idx_menu_items_branch")
  @@index([category_id], map: "idx_menu_items_category")
  @@index([status], map: "idx_menu_items_status")
  @@index([smart_tags_ru], map: "idx_menu_items_smart_tags_ru")
  @@index([smart_tags_tk], map: "idx_menu_items_smart_tags_tk")
  @@index([deleted_at], map: "idx_menu_items_deleted_at")
  @@map("menu_items")
  station_routes KitchenItemRoute[]
  kitchen_tasks  KdsItemTask[]
}

model MenuModifierGroup {
  id          String     @id
  branch_id   String
  menu_item_id String
  name_ru     String
  name_tk     String
  name_en     String?
  min_select  Int        @default(0)
  max_select  Int        @default(1)
  required    Boolean    @default(false)
  sort_order  Int        @default(0)
  status      String     @default("ACTIVE")
  created_at  String
  updated_at  String

  branch      Branch     @relation(fields: [branch_id], references: [id], onDelete: Cascade, map: "menu_modifier_groups_branch_fkey")
  menu_item   MenuItem   @relation(fields: [menu_item_id], references: [id], onDelete: Cascade, map: "menu_modifier_groups_item_fkey")
  modifiers   MenuModifier[]

  @@index([branch_id], map: "idx_menu_modifier_groups_branch")
  @@index([menu_item_id], map: "idx_menu_modifier_groups_item")
  @@map("menu_modifier_groups")
}

model MenuModifier {
  id          String     @id
  group_id    String
  name_ru     String
  name_tk     String
  name_en     String?
  // Stage 37: an option may be backed by a REAL Menu Engine item. That is what lets the Recipe
  // Engine resolve what a chosen component actually consumes, without inventing a second
  // inventory path for modifiers. Nullable: a plain option (e.g. "no onion") has no source item.
  source_menu_item_id String?
  price_delta Decimal    @db.Decimal(12,2) @default(0)
  sort_order  Int        @default(0)
  status      String     @default("ACTIVE")
  created_at  String
  updated_at  String

  group       MenuModifierGroup @relation(fields: [group_id], references: [id], onDelete: Cascade, map: "menu_modifiers_group_fkey")
  source_menu_item MenuItem? @relation("ModifierSourceItem", fields: [source_menu_item_id], references: [id], onDelete: SetNull, map: "menu_modifiers_source_item_fkey")
  order_items OrderItemModifier[]

  @@index([group_id], map: "idx_menu_modifiers_group")
  @@index([source_menu_item_id], map: "idx_menu_modifiers_source_item")
  @@map("menu_modifiers")
}

model DiningArea {
  id          String        @id
  branch_id   String
  name        String
  sort_order  Int           @default(0)
  status      String        @default("ACTIVE")
  created_at  String
  updated_at  String

  branch      Branch        @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  tables      DiningTable[]

  @@index([branch_id], map: "idx_dining_areas_branch")
  @@map("dining_areas")
}

model DiningTable {
  id          String      @id
  branch_id   String
  area_id     String
  code        String
  name        String
  seats       Int
  status      String      @default("AVAILABLE")
  created_at  String
  updated_at  String

  branch      Branch      @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  area        DiningArea  @relation(fields: [area_id], references: [id], onDelete: Restrict)
  orders      Order[]

  @@unique([branch_id, code], map: "dining_tables_branch_code_key")
  @@index([branch_id], map: "idx_dining_tables_branch")
  @@index([area_id], map: "idx_dining_tables_area")
  @@index([status], map: "idx_dining_tables_status")
  @@map("dining_tables")
}

model BranchOrderSequence {
  branch_id   String  @id
  next_value  Int     @default(1)
  updated_at  String
  branch      Branch  @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  @@map("branch_order_sequences")
}

model Order {
  id                 String      @id
  order_number       String
  branch_id          String
  waiter_user_id     String?
  table_id           String?
  order_type         String
  source             String
  status             String
  currency           String
  subtotal           Decimal     @db.Decimal(12,2)
  discount           Decimal     @db.Decimal(12,2) @default(0)
  promotion_amount   Decimal     @db.Decimal(12,2) @default(0)
  service_charge     Decimal     @db.Decimal(12,2) @default(0)
  final_amount       Decimal     @db.Decimal(12,2)
  idempotency_key    String?
  notes              String?
  internal_notes     String?
  created_at         String
  updated_at         String
  confirmed_at       String?
  confirmed_by       String?
  // Stage 34.2: which service charge configuration VERSION produced this order's service_charge.
  // Changing the configuration later never re-prices or re-distributes this order.
  service_charge_config_id String?
  // Stage 34.3: the guest this order belongs to. Attaching a customer NEVER applies a discount --
  // there is no discount field on a customer anywhere in this schema, by design.
  customer_id        String?
  // Stage 34.4: how this order is settled. NONE = one bill for the whole order (the original
  // behaviour). ITEMS = its items are divided between separate bills. EQUAL = its total is divided
  // into equal shares. An order is in exactly ONE of these at a time, which is what makes
  // double-counted revenue structurally impossible.
  split_mode         String      @default("NONE")

  branch             Branch      @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  waiter             User?       @relation("WaiterOrders", fields: [waiter_user_id], references: [id], onDelete: SetNull)
  table              DiningTable? @relation(fields: [table_id], references: [id], onDelete: SetNull)
  items              OrderItem[]
  payments           Payment[]
  kds_ticket         KdsTicket?
  removal_approvals  OrderItemRemovalApproval[]
  service_charge_ledger ServiceChargeLedger[]
  print_jobs PrintJob[]
  credit_transactions CreditTransaction[]
  closures           OrderClosure[]
  discounts          OrderDiscount[]
  bills              OrderBill[]
  boomcoin_ledger    BoomcoinLedger[]
  boomback_ledger    BoombackLedger[]
  compliments        ComplimentRequest[]
  boomcard_events    BoomcardEvent[]
  service_charge_config ServiceChargeConfig? @relation(fields: [service_charge_config_id], references: [id], onDelete: SetNull)
  customer           Customer? @relation(fields: [customer_id], references: [id], onDelete: SetNull)

  @@unique([branch_id, order_number], map: "orders_branch_order_number_key")
  @@unique([branch_id, idempotency_key], map: "orders_branch_idempotency_key_key")
  @@index([branch_id], map: "idx_orders_branch")
  @@index([waiter_user_id], map: "idx_orders_waiter")
  @@index([table_id], map: "idx_orders_table")
  @@index([status], map: "idx_orders_status")
  @@index([created_at], map: "idx_orders_created")
  @@map("orders")
  kitchen_tasks      KdsItemTask[]
  kitchen_comments   KitchenComment[]
  kitchen_alerts     KitchenAlert[]
  expo_handovers     ExpoHandover[]
}

// Stage 34.1: the controlled cancellation / "closed by establishment" workflow. A refund is never
// an arbitrary historical action -- it is authorised by an APPROVED row here. The row also carries
// the explicit inventory decision (write off / leave as consumed / restore) and the production
// state at request time, because refunding money and restoring ingredients are independent facts:
// food that has already been produced is never returned to stock.
model OrderClosure {
  id                  String   @id
  branch_id           String
  order_id            String
  type                String   // CANCELLATION | CLOSED_BY_ESTABLISHMENT
  reason              String
  comment             String?
  inventory_treatment String   // WRITE_OFF | NO_WRITE_OFF | RESTORE_STOCK
  refund_requested    Boolean  @default(false)
  status              String   @default("PENDING") // PENDING | APPROVED | REJECTED
  production_state    String   // NOT_STARTED | QUEUED | PREPARING | READY | SERVED (snapshot at request)
  requester_user_id   String?
  requester_role      String?
  approver_user_id    String?
  decision_reason     String?
  refund_payment_id   String?
  inventory_applied   Boolean  @default(false)
  paid_at_request     Boolean  @default(false)
  write_off_cost      Decimal? @db.Decimal(14, 4)
  created_at          String
  decided_at          String?

  branch    Branch @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  order     Order  @relation(fields: [order_id], references: [id], onDelete: Cascade)
  requester User?  @relation("OrderClosureRequester", fields: [requester_user_id], references: [id], onDelete: SetNull)
  approver  User?  @relation("OrderClosureApprover", fields: [approver_user_id], references: [id], onDelete: SetNull)

  @@index([branch_id, status, created_at], map: "idx_order_closures_branch_status_created")
  @@index([order_id, status], map: "idx_order_closures_order_status")
  @@map("order_closures")
}

// Stage 34.3: a manual discount, granted per order by a person, never by a rule. There is no
// automatic or profile-level discount anywhere in the system: a discount exists only because this
// row exists, and this row only exists because an authorised employee asked for it on that order.
// The row is the audit-grade snapshot (customer, percentage, amount, employee, role, reason,
// timestamp) and is never deleted -- removing a discount marks it REMOVED.
// Stage 34.4: a separate check on one order. A table can carry several of these; the ORDER stays
// the single sale (one order, N bills), so revenue is counted once while each guest settles their
// own part with their own guest, discount, payment method and receipt.
// Stage 34.5: the authoritative BOOMCOIN record. Every coin a guest has ever earned, redeemed or
// had adjusted is one row here, with the balance before and after, so the balance is never a number
// somebody typed -- it is the sum of this ledger. The POS counter is only UI guidance derived from
// the same numbers.
// Stage 34.6: a guest's BOOMCARD. One card per guest, with an explicit lifecycle that a MANAGER
// drives: CANDIDATE (the CRM noticed enough qualifying spend) -> ACTIVE (a manager approved it) ->
// INACTIVE (it lapsed or was withdrawn). Nothing here activates itself; automation only ever
// proposes candidates, and every transition is recorded as its own event so the history survives.
model Boomcard {
  id              String  @id
  branch_id       String
  customer_id     String  @unique
  card_number     String  @unique
  status          String  @default("CANDIDATE") // CANDIDATE | ACTIVE | INACTIVE
  // The personal cabinet is reached by this opaque token, never by the customer id, so a cabinet
  // link cannot be guessed from a record the guest can see elsewhere.
  cabinet_token   String  @unique
  qualifying_spend Decimal @db.Decimal(12, 2) @default(0)
  activated_at    String?
  valid_until     String?
  deactivated_at  String?
  breakfast_granted Int   @default(0)
  breakfast_used    Int   @default(0)
  created_by      String?
  created_at      String
  updated_at      String

  branch   Branch   @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  events   BoomcardEvent[]
  gifts    BoomcardBirthdayGift[]

  @@index([branch_id, status], map: "idx_boomcards_branch_status")
  @@map("boomcards")
}

// Every lifecycle transition and benefit grant, kept forever. Stage 34.12 reads this as part of the
// unified BOOMCARD operations journal.
model BoomcardEvent {
  id          String  @id
  branch_id   String
  boomcard_id String
  customer_id String
  type        String  // CANDIDATE_IDENTIFIED | ACTIVATED | RENEWED | DEACTIVATED | BREAKFAST_GRANTED | BREAKFAST_REDEEMED | BIRTHDAY_GIFT_GRANTED | BIRTHDAY_GIFT_REDEEMED
  status_before String?
  status_after  String?
  qualifying_spend Decimal? @db.Decimal(12, 2)
  period_start String?
  period_end   String?
  quantity     Int?
  reason       String?
  decided_by   String?
  automatic    Boolean @default(false)
  // Stage 34.12: structured drill-down identifiers, populated only where the event actually
  // involves them (a breakfast/birthday-gift REDEMPTION has both; a GRANT or a lifecycle
  // transition has neither) -- never inferred from free-text reason.
  order_id     String?
  menu_item_id String?
  created_at   String

  branch    Branch    @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  boomcard  Boomcard  @relation(fields: [boomcard_id], references: [id], onDelete: Cascade)
  customer  Customer  @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  order     Order?    @relation(fields: [order_id], references: [id], onDelete: SetNull)
  menu_item MenuItem? @relation(fields: [menu_item_id], references: [id], onDelete: SetNull)

  @@index([branch_id, created_at], map: "idx_boomcard_events_branch_created")
  @@index([boomcard_id, created_at], map: "idx_boomcard_events_card_created")
  @@map("boomcard_events")
}

// A birthday benefit a MANAGER assigns by hand: a specific menu item, a specific quantity, a
// specific validity window. The guest's own cabinet deliberately sees only that a birthday benefit
// is waiting -- never which product it is.
model BoomcardBirthdayGift {
  id           String  @id
  branch_id    String
  boomcard_id  String
  customer_id  String
  menu_item_id String
  quantity     Int     @default(1)
  status       String  @default("GRANTED") // GRANTED | REDEEMED | EXPIRED
  valid_from   String
  valid_until  String
  granted_by   String?
  granted_at   String
  redeemed_at  String?
  redeemed_order_id String?

  branch    Branch   @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  boomcard  Boomcard @relation(fields: [boomcard_id], references: [id], onDelete: Cascade)
  customer  Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  menu_item MenuItem @relation(fields: [menu_item_id], references: [id], onDelete: Restrict)

  @@index([branch_id, status], map: "idx_boomcard_gifts_branch_status")
  @@index([customer_id, status], map: "idx_boomcard_gifts_customer_status")
  @@map("boomcard_birthday_gifts")
}

// Stage 34.7: the authoritative BOOMBACK record.
//
// BOOMBACK IS NOT A DISCOUNT. It is a monetary instrument the guest holds and spends: paying 500
// BOOMBACK against a 1000 order leaves 500 to settle in cash or card, and the receipt shows it as a
// payment line (BOOMBACK -500), never as a price reduction. The order's subtotal, discount and
// final amount are completely untouched by it.
model BoombackLedger {
  id             String   @id
  branch_id      String
  customer_id    String
  type           String   // EARNED | REDEEMED | ADJUSTMENT | REVERSED
  amount         Decimal  @db.Decimal(12, 2) // signed: negative when the guest spends it
  balance_before Decimal  @db.Decimal(12, 2)
  balance_after  Decimal  @db.Decimal(12, 2)
  order_id       String?
  bill_id        String?
  payment_id     String?
  reason         String?
  created_by     String?
  created_at     String
  // Never null, so idempotency genuinely holds.
  entry_key      String   @unique(map: "uq_boomback_ledger_entry_key")

  branch   Branch     @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  customer Customer   @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  order    Order?     @relation(fields: [order_id], references: [id], onDelete: SetNull)
  bill     OrderBill? @relation(fields: [bill_id], references: [id], onDelete: SetNull)
  payment  Payment?   @relation(fields: [payment_id], references: [id], onDelete: SetNull)

  @@index([branch_id, created_at], map: "idx_boomback_ledger_branch_created")
  @@index([customer_id, created_at], map: "idx_boomback_ledger_customer_created")
  @@map("boomback_ledger")
}

model BoomcoinLedger {
  id                String   @id
  branch_id         String
  customer_id       String
  type              String   // EARNED | REDEEMED | ADJUSTMENT | REVERSED
  coins             Int      // signed: negative for a redemption or a reversal
  qualifying_amount Decimal  @db.Decimal(12, 2) @default(0)
  balance_before    Int
  balance_after     Int
  spend_before      Decimal  @db.Decimal(12, 2) @default(0)
  spend_after       Decimal  @db.Decimal(12, 2) @default(0)
  order_id          String?
  bill_id           String?
  reason            String?
  created_by        String?
  created_at        String
  // Never null, so idempotency genuinely holds: a retried payment cannot mint a second coin.
  entry_key         String   @unique(map: "uq_boomcoin_ledger_entry_key")

  branch   Branch     @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  customer Customer   @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  order    Order?     @relation(fields: [order_id], references: [id], onDelete: SetNull)
  bill     OrderBill? @relation(fields: [bill_id], references: [id], onDelete: SetNull)

  @@index([branch_id, created_at], map: "idx_boomcoin_ledger_branch_created")
  @@index([customer_id, created_at], map: "idx_boomcoin_ledger_customer_created")
  @@map("boomcoin_ledger")
}

// Stage 34.8: a complimentary item -- "от заведения". A waiter or cashier REQUESTS it; exactly one
// authorised manager approves it; only then does a real order line appear at a customer price of 0.
// The guest pays nothing, but the establishment's real cost is still recorded through the ordinary
// recipe-consumption path, and the normal menu value is snapshotted so the give-away can be valued.
model ComplimentRequest {
  id                String   @id
  branch_id         String
  order_id          String
  bill_id           String?
  customer_id       String?
  menu_item_id      String
  order_item_id     String?
  quantity          Int      @default(1)
  reason            String   // COMPLIMENT | APOLOGY | GIFT | ESTABLISHMENT_ERROR | BIRTHDAY | OTHER
  comment           String?
  status            String   @default("PENDING") // PENDING | APPROVED | REJECTED
  normal_value      Decimal  @db.Decimal(12, 2)
  requester_user_id String?
  requester_role    String
  source            String   // WAITER_POS | CASHIER_POS
  approver_user_id  String?
  decision_reason   String?
  created_at        String
  decided_at        String?

  branch     Branch     @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  order      Order      @relation(fields: [order_id], references: [id], onDelete: Cascade)
  bill       OrderBill? @relation(fields: [bill_id], references: [id], onDelete: SetNull)
  customer   Customer?  @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  menu_item  MenuItem   @relation(fields: [menu_item_id], references: [id], onDelete: Restrict)
  order_item OrderItem? @relation(fields: [order_item_id], references: [id], onDelete: SetNull)
  requester  User?      @relation("ComplimentRequester", fields: [requester_user_id], references: [id], onDelete: SetNull)
  approver   User?      @relation("ComplimentApprover", fields: [approver_user_id], references: [id], onDelete: SetNull)

  @@index([branch_id, status, created_at], map: "idx_compliment_requests_branch_status_created")
  @@index([order_id, status], map: "idx_compliment_requests_order_status")
  @@map("compliment_requests")
}

model OrderBill {
  id             String   @id
  branch_id      String
  order_id       String
  bill_number    Int
  customer_id    String?
  status         String   @default("OPEN") // OPEN | PAID | VOID
  subtotal       Decimal  @db.Decimal(12, 2) @default(0)
  discount       Decimal  @db.Decimal(12, 2) @default(0)
  service_charge Decimal  @db.Decimal(12, 2) @default(0)
  final_amount   Decimal  @db.Decimal(12, 2) @default(0)
  created_at     String
  updated_at     String
  closed_at      String?

  branch    Branch    @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  order     Order     @relation(fields: [order_id], references: [id], onDelete: Cascade)
  customer  Customer? @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  items     OrderItem[]
  payments  Payment[]
  discounts OrderDiscount[]
  boomcoin_ledger BoomcoinLedger[]
  boomback_ledger BoombackLedger[]
  compliments     ComplimentRequest[]

  @@unique([order_id, bill_number], map: "uq_order_bills_order_number")
  @@index([branch_id, status], map: "idx_order_bills_branch_status")
  @@map("order_bills")
}

model OrderDiscount {
  id                 String   @id
  branch_id          String
  order_id           String
  bill_id            String?
  customer_id        String?
  percent            Decimal? @db.Decimal(5, 2)
  amount             Decimal  @db.Decimal(12, 2)
  base_amount        Decimal  @db.Decimal(12, 2)
  reason             String?
  applied_by_user_id String?
  applied_by_role    String
  source             String   // WAITER_POS | CASHIER_POS
  status             String   @default("ACTIVE") // ACTIVE | REMOVED
  created_at         String
  removed_at         String?
  removed_by         String?

  branch     Branch    @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  order      Order      @relation(fields: [order_id], references: [id], onDelete: Cascade)
  bill       OrderBill? @relation(fields: [bill_id], references: [id], onDelete: Cascade)
  customer   Customer?  @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  applied_by User?      @relation("OrderDiscountAppliedBy", fields: [applied_by_user_id], references: [id], onDelete: SetNull)

  @@index([order_id, status], map: "idx_order_discounts_order_status")
  @@index([branch_id, created_at], map: "idx_order_discounts_branch_created")
  @@map("order_discounts")
}

model OrderItem {
  id             String     @id
  order_id       String
  // Stage 34.4: which separate check this line is settled on. Null while the order is not split.
  bill_id        String?
  menu_item_id   String?
  title_snapshot String
  price_snapshot Decimal    @db.Decimal(12,2)
  quantity       Int
  subtotal       Decimal    @db.Decimal(12,2)
  comment        String?
  status         String     @default("ACTIVE")
  removed_quantity Decimal  @db.Decimal(12,4) @default(0)
  removed_at     String?
  removed_by     String?
  removal_reason String?
  // Stage 34: the recipe version and its total ingredient cost AS OF the moment consumption
  // happened (payment time), so a later recipe/cost change never changes this line's historical
  // economics. Null when the item had no active recipe at consumption time (e.g. no menu_item,
  // or never consumed because the order was never paid).
  recipe_version_snapshot Int?
  recipe_cost_snapshot    Decimal? @db.Decimal(14,4)
  created_at     String

  order          Order      @relation(fields: [order_id], references: [id], onDelete: Cascade)
  bill           OrderBill? @relation(fields: [bill_id], references: [id], onDelete: SetNull)
  menu_item      MenuItem?  @relation(fields: [menu_item_id], references: [id], onDelete: SetNull)
  removal_approvals OrderItemRemovalApproval[]
  modifiers        OrderItemModifier[]
  compliments      ComplimentRequest[]

  kitchen_tasks     KdsItemTask[]
  kitchen_comments  KitchenComment[]

  @@index([order_id], map: "idx_order_items_order")
  @@index([menu_item_id], map: "idx_order_items_menu_item")
  @@index([order_id, status], map: "idx_order_items_order_status")
  @@index([bill_id], map: "idx_order_items_bill")
  @@map("order_items")
}


model OrderItemModifier {
  id                    String   @id
  order_item_id         String
  modifier_id           String?
  name_snapshot         String
  price_delta_snapshot  Decimal  @db.Decimal(12,2)
  quantity              Int      @default(1)
  // Stage 38: the INTERNAL cost half of a chosen component, mirroring exactly what
  // order_items already carries for the base dish. When a modifier option is backed by a real
  // menu item (Stage 37's source_menu_item_id) and that item has an active recipe, these record
  // the recipe version and the ingredient cost AT THE MOMENT OF CONSUMPTION, so a later recipe
  // or ingredient-cost change never rewrites this line's economics. Null when the option has no
  // source item, no active recipe, or was never consumed (the order was never paid).
  //
  // price_delta_snapshot above is the SELLING price and stays exactly as it was -- these two are
  // never shown on a customer, QR or POS surface.
  recipe_version_snapshot Int?
  recipe_cost_snapshot    Decimal? @db.Decimal(14,4)
  created_at            String

  order_item OrderItem   @relation(fields: [order_item_id], references: [id], onDelete: Cascade, map: "order_item_modifiers_item_fkey")
  modifier   MenuModifier? @relation(fields: [modifier_id], references: [id], onDelete: SetNull, map: "order_item_modifiers_modifier_fkey")

  @@index([order_item_id], map: "idx_order_item_modifiers_item")
  @@map("order_item_modifiers")
}

model OrderItemRemovalApproval {
  id                 String   @id
  order_id           String
  order_item_id      String
  branch_id          String
  requester_user_id  String
  approver_user_id   String?
  requested_quantity Decimal  @db.Decimal(12,4)
  reason             String
  status             String   @default("PENDING")
  created_at         String
  decided_at         String?
  decision_reason    String?

  order              Order      @relation(fields: [order_id], references: [id], onDelete: Cascade)
  order_item         OrderItem  @relation(fields: [order_item_id], references: [id], onDelete: Cascade)
  branch             Branch     @relation(fields: [branch_id], references: [id], onDelete: Restrict)

  @@index([branch_id, status, created_at], map: "idx_order_item_removal_branch_status_created")
  @@index([order_id, status], map: "idx_order_item_removal_order_status")
  @@index([order_item_id, status], map: "idx_order_item_removal_item_status")
  @@map("order_item_removal_approvals")
}


model CashShift {
  id              String   @id
  branch_id       String
  cashier_user_id String
  status          String   @default("OPEN")
  opening_cash    Decimal  @db.Decimal(12,2)
  cash_sales      Decimal  @db.Decimal(12,2) @default(0)
  card_sales      Decimal  @db.Decimal(12,2) @default(0)
  online_sales    Decimal  @db.Decimal(12,2) @default(0)
  bonus_sales    Decimal  @db.Decimal(12,2) @default(0)
  refunds        Decimal  @db.Decimal(12,2) @default(0)
  voids          Decimal  @db.Decimal(12,2) @default(0)
  // Cash physically received in this shift from a credit-account repayment. Kept separate
  // from cash_sales (which is exclusively order-payment sales) so reports never count a
  // repayment as a new sale, while the drawer still reconciles correctly at Z-report time.
  credit_repayments Decimal @db.Decimal(12,2) @default(0)
  expected_cash  Decimal  @db.Decimal(12,2) @default(0)
  actual_cash    Decimal? @db.Decimal(12,2)
  difference     Decimal? @db.Decimal(12,2)
  opened_at      String
  closed_at      String?
  created_at     String
  updated_at     String

  branch         Branch   @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  cashier        User     @relation(fields: [cashier_user_id], references: [id], onDelete: Restrict)
  payments       Payment[]

  @@index([branch_id, status], map: "idx_cash_shifts_branch_status")
  @@index([cashier_user_id, opened_at], map: "idx_cash_shifts_cashier_opened")
  @@map("cash_shifts")
}

model Payment {
  id                 String   @id
  order_id           String
  // Stage 34.4: which separate check this payment settles. Null when the order is not split.
  bill_id            String?
  branch_id          String
  cash_shift_id      String?
  cashier_user_id    String
  method             String
  status             String   @default("PAID")
  amount             Decimal  @db.Decimal(12,2)
  external_reference String?
  idempotency_key    String?
  created_at         String
  updated_at         String
  refunded_at        String?

  order              Order      @relation(fields: [order_id], references: [id], onDelete: Restrict)
  bill               OrderBill? @relation(fields: [bill_id], references: [id], onDelete: SetNull)
  branch             Branch     @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  cash_shift         CashShift? @relation(fields: [cash_shift_id], references: [id], onDelete: Restrict)
  cashier            User     @relation(fields: [cashier_user_id], references: [id], onDelete: Restrict)
  credit_transactions CreditTransaction[]
  boomback_ledger    BoombackLedger[]

  @@unique([branch_id, idempotency_key], map: "payments_branch_idempotency_key_key")
  @@index([order_id, status], map: "idx_payments_order_status")
  @@index([bill_id, status], map: "idx_payments_bill_status")
  @@index([branch_id, created_at], map: "idx_payments_branch_created")
  @@index([cash_shift_id], map: "idx_payments_shift")
  @@map("payments")
}

// Minimal customer identity for Credit Mode -- name + phone, branch-scoped. Not a full CRM;
// no adequate customer/CRM model existed anywhere in the schema before this (Sidebar.tsx's
// own "Future Modules" list explicitly marks CRM as not yet built), so this seed record is
// added rather than repurposing User (a staff login identity, not a customer).
model Customer {
  id         String   @id
  branch_id  String
  name       String
  // Stage 34.9: a guest can be created from the POS with a NAME ALONE. A phone is what lets the
  // same guest be recognised across visits and surfaces, so it stays unique per branch when given
  // -- Postgres allows many NULLs in a unique index, so "no phone" never collides.
  phone      String?
  email      String?
  notes      String?
  status     String   @default("ACTIVE")
  deleted_at String?
  created_at String
  updated_at String

  branch          Branch          @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  credit_accounts CreditAccount[]
  // Stage 34.5: loyalty aggregates. These are a CACHE maintained in the same transaction as the
  // ledger row that caused them -- the boomcoin_ledger is the authoritative record, and the read
  // endpoints recompute from it so the two can be proven equal.
  boomcoin_balance Int    @default(0)
  qualifying_spend Decimal @db.Decimal(12, 2) @default(0)
  // Stage 34.6: the guest's date of birth, used only to decide when a birthday benefit may be
  // granted. It is never a discount and never grants anything by itself.
  birth_date       String?
  // Stage 34.7: BOOMBACK is MONEY the guest holds, not a discount. Same rule as BOOMCOIN -- this
  // column is a cache; boomback_ledger is the authoritative balance.
  boomback_balance Decimal @db.Decimal(12, 2) @default(0)

  orders          Order[]
  discounts       OrderDiscount[]
  bills           OrderBill[]
  boomcoin_ledger BoomcoinLedger[]
  boomback_ledger BoombackLedger[]
  boomcard        Boomcard?
  boomcard_events BoomcardEvent[]
  birthday_gifts  BoomcardBirthdayGift[]
  compliments     ComplimentRequest[]

  @@unique([branch_id, phone], map: "customers_branch_phone_key")
  @@index([branch_id], map: "idx_customers_branch")
  @@index([deleted_at], map: "idx_customers_deleted_at")
  @@map("customers")
}

// The receivable itself. Exactly one account per (branch, customer) or (branch, employee) --
// type discriminates which owner field is populated. current_balance is a materialized,
// atomically-maintained running total; it must always equal SUM of this account's
// CreditTransaction amounts (CREDIT/PAYROLL_DEDUCTION increase it, REPAYMENT decreases it,
// ADJUSTMENT is signed) -- verified by tests, never trusted blindly.
model CreditAccount {
  id              String   @id
  type            String   // CUSTOMER | EMPLOYEE
  customer_id     String?
  employee_id     String?
  branch_id       String
  credit_limit    Decimal  @db.Decimal(12,2) @default(0)
  current_balance Decimal  @db.Decimal(12,2) @default(0)
  status          String   @default("ACTIVE")
  created_at      String
  updated_at      String

  customer     Customer?  @relation(fields: [customer_id], references: [id], onDelete: Restrict)
  employee     User?      @relation("EmployeeCreditAccounts", fields: [employee_id], references: [id], onDelete: Restrict)
  branch       Branch     @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  transactions CreditTransaction[]

  @@unique([branch_id, customer_id], map: "credit_accounts_branch_customer_key")
  @@unique([branch_id, employee_id], map: "credit_accounts_branch_employee_key")
  @@index([branch_id, type], map: "idx_credit_accounts_branch_type")
  @@map("credit_accounts")
}

// Immutable ledger entry. Never updated or deleted after creation -- CreditAccount.
// current_balance is the only mutable derived field, and only ever changes inside the same
// transaction that inserts the CreditTransaction row that justifies the change.
model CreditTransaction {
  id                String   @id
  credit_account_id String
  type              String   // CREDIT | REPAYMENT | ADJUSTMENT | PAYROLL_DEDUCTION
  amount            Decimal  @db.Decimal(12,2)
  order_id          String?
  payment_id        String?
  branch_id         String
  cashier_user_id   String
  approved_by       String?
  method            String?  // repayment method: CASH | CARD | ... | PAYROLL_DEDUCTION
  note              String?
  idempotency_key   String?
  created_at        String

  credit_account CreditAccount @relation(fields: [credit_account_id], references: [id], onDelete: Restrict)
  order          Order?        @relation(fields: [order_id], references: [id], onDelete: SetNull)
  payment        Payment?      @relation(fields: [payment_id], references: [id], onDelete: SetNull)
  branch         Branch        @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  cashier        User          @relation("CreditTransactionsAsCashier", fields: [cashier_user_id], references: [id], onDelete: Restrict)
  approver       User?         @relation("CreditTransactionsAsApprover", fields: [approved_by], references: [id], onDelete: SetNull)

  @@unique([branch_id, idempotency_key], map: "credit_tx_branch_idempotency_key")
  @@index([credit_account_id, created_at], map: "idx_credit_tx_account_created")
  @@index([branch_id, created_at], map: "idx_credit_tx_branch_created")
  @@index([order_id], map: "idx_credit_tx_order")
  @@map("credit_transactions")
}

model KdsTicket {
  id          String   @id
  order_id    String   @unique
  branch_id   String
  status      String   @default("NEW")
  created_at  String
  updated_at  String
  started_at  String?
  ready_at    String?
  completed_at String?

