  branch      Branch  @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  @@index([branch_id, status], map: "idx_operator_sessions_branch_status")
  @@index([user_id, status], map: "idx_operator_sessions_user_status")
  @@index([user_id, branch_id, status, expires_at], map: "idx_operator_pos_active_lookup")
  @@map("operator_pos_sessions")
}

model PrintProfile {
  id          String  @id
  branch_id   String
