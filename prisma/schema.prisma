model InventoryItem {
  id              String   @id
  branch_id       String
  sku             String
  name            String
  unit            String
  current_stock   Decimal  @db.Decimal(14,4) @default(0)
  reorder_point   Decimal  @db.Decimal(14,4) @default(0)
  // Stage 34: authoritative moving weighted-average unit cost, maintained incrementally on every
  // PURCHASE receipt (see inventory.ts /purchases/:id/receive). This is the single cost basis
  // recipe costing reads -- no second costing method, no per-report recomputation from history.
  average_cost    Decimal  @db.Decimal(14,4) @default(0)
  active          Boolean  @default(true)
  created_at      String
  updated_at      String

  branch          Branch   @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  recipe_ingredients RecipeIngredient[]
  stock_movements StockMovement[]
  purchase_items  PurchaseItem[]
  inventory_counts InventoryCount[]

  @@unique([branch_id, sku], map: "inventory_items_branch_sku_key")
  @@index([branch_id, active], map: "idx_inventory_items_branch_active")
  @@index([branch_id, current_stock, reorder_point], map: "idx_inventory_items_low_stock")
  @@map("inventory_items")
}

model Recipe {
  id          String   @id
  branch_id   String
  menu_item_id String
  name       String
  // Stage 34: recipe versioning. A recipe edit never mutates an existing row -- it inserts a new
  // version and flips active off on the previous one (same transaction), so an order_item's
  // recipe_version_snapshot always resolves to an immutable historical row.
  version    Int      @default(1)
  yield_qty  Decimal  @db.Decimal(14,4) @default(1)
  active     Boolean  @default(true)
  created_at String
  updated_at String

  branch      Branch @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  menu_item   MenuItem @relation(fields: [menu_item_id], references: [id], onDelete: Restrict)
  ingredients RecipeIngredient[]

  @@unique([branch_id, menu_item_id, version], map: "recipes_branch_menu_item_version_key")
  @@index([branch_id, active], map: "idx_recipes_branch_active")
  @@index([branch_id, menu_item_id, active], map: "idx_recipes_branch_menu_item_active")
  @@map("recipes")
}

// Stage 34: an explicit, controlled physical-count event -- theoretical (system) quantity vs.
// counted (actual) quantity at the moment of counting, with the resulting delta applied through
// the existing ADJUSTMENT stock-movement path (never a silent direct stock mutation).
model InventoryCount {
  id                   String   @id
  branch_id            String
  inventory_item_id    String
  theoretical_quantity Decimal  @db.Decimal(14,4)
  counted_quantity     Decimal  @db.Decimal(14,4)
  delta                Decimal  @db.Decimal(14,4)
  reason               String?
  counted_by           String
  stock_movement_id    String?
  created_at           String

  branch         Branch        @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  inventory_item InventoryItem @relation(fields: [inventory_item_id], references: [id], onDelete: Restrict)
  counter        User          @relation(fields: [counted_by], references: [id], onDelete: Restrict)

  @@index([branch_id, created_at], map: "idx_inventory_counts_branch_created")
  @@index([inventory_item_id, created_at], map: "idx_inventory_counts_item_created")
  @@map("inventory_counts")
}

model RecipeIngredient {
  id              String  @id
  recipe_id       String
  inventory_item_id String
  quantity        Decimal @db.Decimal(14,4)
  created_at      String

  recipe          Recipe @relation(fields: [recipe_id], references: [id], onDelete: Cascade)
  inventory_item  InventoryItem @relation(fields: [inventory_item_id], references: [id], onDelete: Restrict)

  @@unique([recipe_id, inventory_item_id], map: "recipe_ingredients_recipe_item_key")
  @@index([inventory_item_id], map: "idx_recipe_ingredients_inventory")
  @@map("recipe_ingredients")
}

model Supplier {
  id          String  @id
